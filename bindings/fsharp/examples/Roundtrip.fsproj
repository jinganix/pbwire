<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Roundtrip</AssemblyName>
    <RootNamespace>Pbwire.FSharp.Example</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="gen/addressbook_meta.fs" />
    <Compile Include="gen/addressbook.fs" />
    <Compile Include="Roundtrip.fs" />
    <ProjectReference Include="../runtime/Pbwire.FSharp.fsproj" />
  </ItemGroup>

</Project>
