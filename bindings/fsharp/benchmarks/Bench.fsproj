<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bench</AssemblyName>
    <RootNamespace>Pbwire.FSharp.Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bench.fs" />
    <ProjectReference Include="../runtime/Pbwire.FSharp.fsproj" />
    <ProjectReference Include="baseline/Baseline.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
  </ItemGroup>

</Project>
