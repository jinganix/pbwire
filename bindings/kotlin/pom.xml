<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.jinganix</groupId>
  <artifactId>pbwire-kotlin</artifactId>
  <!-- Release version: kept in sync with the repo-root VERSION file by
       scripts/sync-versions.sh; never edit by hand. -->
  <version>0.1.16</version>
  <packaging>jar</packaging>

  <name>pbwire-kotlin</name>
  <description>Dynamic protobuf over the pbwire C ABI: Kotlin DSL over the pbwire-java FFM layer</description>
  <url>https://github.com/jinganix/pbwire</url>
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>gan.jin</id>
      <name>JinGan</name>
      <email>jinganix@gmail.com</email>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/jinganix/pbwire</url>
    <connection>scm:git:git://github.com/jinganix/pbwire.git</connection>
    <developerConnection>scm:git:ssh://github.com/jinganix/pbwire.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <!-- No maven.compiler.release here: the Kotlin compiler does not read it,
       and the javadoc plugin would inherit it and fail on a JDK older than
       the release it names. -->
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <kotlin.version>2.1.0</kotlin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.jinganix</groupId>
      <artifactId>pbwire-java</artifactId>
      <!-- Same release line: the sync script keeps this aligned with VERSION. -->
      <version>0.1.16</version>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>${kotlin.version}</version>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>runtime</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>compile</id>
            <goals><goal>compile</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Pure Kotlin runtime, so javadoc documents the stub package
             description in javadoc/ instead of the .kt sources. -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
            <configuration>
              <sourcepath>${project.basedir}/javadoc</sourcepath>
              <!-- Pure Kotlin runtime: nothing for javadoc to document, but
                   Central requires the jar to exist, so generate (empty) and
                   attach it instead of failing. -->
              <failOnError>false</failOnError>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-gpg-plugin</artifactId>
        <version>3.2.8</version>
        <executions>
          <execution>
            <id>sign-artifacts</id>
            <phase>verify</phase>
            <goals><goal>sign</goal></goals>
            <configuration>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- Portal publishing: intercepts `mvn deploy`, uploads the bundle,
           validates it and publishes (server id matches distributionManagement
           and the setup-java server-username/password env). -->
      <plugin>
        <groupId>org.sonatype.central</groupId>
        <artifactId>central-publishing-maven-plugin</artifactId>
        <version>0.12.0</version>
        <extensions>true</extensions>
        <configuration>
          <publishingServerId>central</publishingServerId>
          <autoPublish>true</autoPublish>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <snapshotRepository>
      <id>central</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
    </snapshotRepository>
    <repository>
      <id>central</id>
      <url>https://central.sonatype.com/api/v1/publisher/upload</url>
    </repository>
  </distributionManagement>
</project>
