{application, pbwire, [
    {description,
        "Fast Google Protobuf (proto2/proto3) encoder and decoder for Erlang/OTP, implemented as a C "
        "NIF. Drop-in replacement for gpb encode_msg/1 and decode_msg/2."},
    {vsn, "0.1.15"},
    {registered, []},
    {applications, [kernel, stdlib]},
    {maintainers, ["gan.jin <jinganix@gmail.com>"]},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/jinganix/pbwire"},
        {"Hex", "https://hex.pm/packages/pbwire"}
    ]},
    {files, [
        "LICENSE",
        "Makefile",
        "README.md",
        "rebar.config",
        "rebar.lock",
        "c_src/Makefile",
        "c_src/*.c",
        "c_src/*.h",
        "c_src/core/include/pbwire.h",
        "c_src/core/src/*.c",
        "c_src/core/src/*.h",
        "priv/.gitignore",
        "src/*.app.src",
        "src/*.erl"
    ]}
]}.
