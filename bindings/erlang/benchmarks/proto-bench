#! /usr/bin/env escript
%% -*- erlang -*-
%%! -pa ../_build/test/lib/gpb/ebin -pa ../_build/default/lib/enif_protobuf/ebin -pa tmp/

%% Unified Erlang benchmark: `bindings/c/tests/data/matrix3.proto`, the same
%% message and payload every other binding measures (BENCHMARKS.md at the repo
%% root), for enif_protobuf (pbwire-erlang) against gpb (pure Erlang) and the
%% gpb libprotobuf NIF when it was built.
%%
%%   ./proto-bench [--backend gpb|epb|nif] ...
%%
%% The four tiers scale the repeated fields x0 / x1 / x100 / x3000, and every
%% backend must produce the same 136 / 174 / 2469 / 74913 bytes before
%% anything is timed. Output is the standard block shape:
%%
%%   <case>: <bytes> bytes, <iterations> iterations (repeated fields x<n>)
%%     impl      op           ns/op       MB/s
%%
%% BENCH_TARGET_TIME (seconds, default 0.25) is the minimum duration of one
%% timed sample; iterations double until the slowest operation reaches it,
%% then the best of three samples is reported. Same unified standard as every
%% other binding (see BENCHMARKS.md).

-mode(compile).
-export([main/1]).

-define(MSG, 'Scalars3').
-define(TIERS, [{"small", 0, 136},
                {"medium", 1, 174},
                {"large", 100, 2469},
                {"xlarge", 3000, 74913}]).
-define(SAMPLES, 3).

main(Args) ->
    Backends = backends(Args),
    %% Measure in a process with a large heap and binary vheap: a 74 KB payload
    %% allocates constantly, and a small default vheap would time the GC.
    {Pid, Monitor} =
        spawn_opt(fun() -> run(Backends) end,
                  [monitor, {min_heap_size, 10000000},
                   {min_bin_vheap_size, 10000000}]),
    receive
        {'DOWN', Monitor, process, Pid, normal} ->
            ok;
        {'DOWN', Monitor, process, Pid, Reason} ->
            error({benchmark_failed, Reason})
    end.

run(Backends) ->
    case lists:keymember(epb, 1, Backends) of
        true -> ok = enif_protobuf:load_cache(matrix3_r:get_proto_defs());
        false -> ok
    end,
    [run_case(Label, Repeats, Want, Backends) || {Label, Repeats, Want} <- ?TIERS],
    ok.

backends(Args) ->
    case requested(Args) of
        [] ->
            [backend(Name) || Name <- [epb, gpb, nif], available(Name)];
        Names ->
            [required(Name) || Name <- Names],
            [backend(Name) || Name <- Names]
    end.

requested(Args) ->
    requested(Args, []).

requested([], Acc) ->
    lists:reverse(Acc);
requested(["--backend", Name | Rest], Acc) ->
    case lists:member(Name, ["gpb", "epb", "nif"]) of
        true -> requested(Rest, [list_to_atom(Name) | Acc]);
        false -> usage("unknown backend " ++ Name)
    end;
requested([Other | _], _Acc) ->
    usage("unexpected argument " ++ Other).

available(nif) -> code:which(matrix3) =/= non_existing;
available(_Name) -> true.

required(Name) ->
    case available(Name) of
        true -> ok;
        false -> usage(impl(Name) ++ " is not built")
    end.

usage(What) ->
    io:format(standard_error,
              "Usage: proto-bench [--backend gpb|epb|nif] ...~n  ~s~n", [What]),
    halt(2).

backend(epb) ->
    {epb, fun enif_protobuf:encode/1,
        fun(Bin) -> enif_protobuf:decode(Bin, ?MSG) end};
backend(gpb) ->
    {gpb, fun matrix3_r:encode_msg/1,
        fun(Bin) -> matrix3_r:decode_msg(Bin, ?MSG) end};
backend(nif) ->
    {nif, fun matrix3:encode_msg/1,
        fun(Bin) -> matrix3:decode_msg(Bin, ?MSG) end}.

run_case(Label, Repeats, Want, Backends) ->
    Msg = scalars3(Repeats),
    {gpb, GpbEncode, _} = backend(gpb),
    Ref = GpbEncode(Msg),
    check_size(Label, byte_size(Ref), Want),
    [check_parity(Label, Name, Encode, Decode, Msg, Ref)
     || {Name, Encode, Decode} <- Backends],
    Ops = lists:flatmap(
            fun({Name, Encode, Decode}) ->
                    [{Name, "encode", fun() -> Encode(Msg) end},
                     {Name, "decode", fun() -> Decode(Ref) end}]
            end, Backends),
    Iterations = iterations([Op || {_, _, Op} <- Ops], 1),
    [run(Op, Iterations) || {_, _, Op} <- Ops],    %% warm-up
    print(Label, Repeats, byte_size(Ref), Iterations, best(Ops, Iterations)).

check_bytes(Label, Name, What, Got, Ref) ->
    case Got of
        Ref -> ok;
        _ -> fail(Label, io_lib:format("~s ~s differs (~w vs ~w bytes)",
                                       [impl(Name), What, byte_size(Got), byte_size(Ref)]))
    end.

check_size(Label, Got, Want) ->
    case Got of
        Want -> ok;
        _ -> fail(Label, io_lib:format("gpb wrote ~w bytes, expected ~w", [Got, Want]))
    end.

%% Bytes are the contract, and a decoded tree has to re-encode to the same
%% bytes: a speed number from a wrong codec is meaningless.
check_parity(Label, Name, Encode, Decode, Msg, Ref) ->
    check_bytes(Label, Name, "encode", Encode(Msg), Ref),
    check_bytes(Label, Name, "decode/re-encode", Encode(Decode(Ref)), Ref),
    io:format("OK   ~s: ~s encode/decode parity (~w bytes)~n",
              [Label, impl(Name), byte_size(Ref)]).

iterations(Ops, N) ->
    Slowest = lists:max([run(Op, N) || Op <- Ops]),
    case Slowest >= target_time() of
        true -> N;
        false -> iterations(Ops, N * 2)
    end.

best(Ops, N) ->
    lists:foldl(
      fun(_, Best) ->
              lists:foldl(
                fun({Name, Op, Fun}, Acc) ->
                        Ns = run(Fun, N) * 1000000000 / N,
                        Key = {Name, Op},
                        case maps:find(Key, Acc) of
                            {ok, Previous} when Previous =< Ns -> Acc;
                            _ -> maps:put(Key, Ns, Acc)
                        end
                end, Best, Ops)
      end, maps:new(), lists:seq(1, ?SAMPLES)).

run(Fun, N) ->
    erlang:garbage_collect(),
    Started = erlang:monotonic_time(),
    iterate(N, Fun),
    erlang:convert_time_unit(erlang:monotonic_time() - Started, native, microsecond)
        / 1000000.

iterate(N, Fun) when N > 0 ->
    Fun(),
    iterate(N - 1, Fun);
iterate(0, _Fun) ->
    ok.

target_time() ->
    case os:getenv("BENCH_TARGET_TIME") of
        false -> 0.25;
        Value ->
            try list_to_float(Value)
            catch error:badarg -> float(list_to_integer(Value))
            end
    end.

print(Label, Repeats, Size, Iterations, Best) ->
    io:format("~s: ~w bytes, ~w iterations (repeated fields x~w)~n",
              [Label, Size, Iterations, Repeats]),
    io:format("  ~-14s ~-7s ~12s ~10s~n", ["impl", "op", "ns/op", "MB/s"]),
    Names = lists:usort([Name || {Name, _Op} <- maps:keys(Best)]),
    [print_row(Name, "encode", Size, maps:get({Name, "encode"}, Best))
     || Name <- Names],
    [print_row(Name, "decode", Size, maps:get({Name, "decode"}, Best))
     || Name <- Names],
    io:format("~n").

print_row(Name, Op, Size, Ns) ->
    io:format("  ~-14s ~-7s ~12.1f ~10.1f~n",
              [impl(Name), Op, Ns, Size / Ns * 1000]).

impl(epb) -> "pbwire-erlang";
impl(gpb) -> "gpb";
impl(nif) -> "gpb-nif".

fail(Label, Reason) ->
    io:format(standard_error, "FAIL ~s: ~s~n", [Label, Reason]),
    halt(1).

%% The matrix3.txt payload: every singular scalar non-default on purpose
%% (proto3 implicit presence has no has-flag), repeated fields scaled by n.
scalars3(N) ->
    {'Scalars3',
        -2147483648,
        9223372036854775807,
        4294967295,
        18446744073709551615,
        -2147483648,
        -9223372036854775808,
        3735928559,
        72623859790382856,
        -2147483648,
        -9223372036854775808,
        infinity,
        -123456.789,
        true,
        "hello",
        'COLOR3_GREEN',
        {'Inner3', "kid", 42},
        [I - 3 || I <- lists:seq(0, N - 1)],
        lists:duplicate(N, "tag"),
        [{'Inner3', "grandkid", I + 1} || I <- lists:seq(0, N - 1)],
        -7,
        "opt",
        [I rem 2 =:= 0 || I <- lists:seq(0, N - 1)]}.
