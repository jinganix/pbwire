    .dependencies = .{
        .zig_protobuf = .{
            .url = "https://github.com/Arwalk/zig-protobuf/archive/83e402d07d0de80f25336b7a99bb751ba1008e71.tar.gz",
            .hash = "protobuf-7.0.0-0e82akowOwBt9kGJyQm9839yrGtJ-4WY3z7-X9D-oiWO",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "runtime",
        "examples",
        "tests",
        "benchmarks",
        "conformance",
        "README.md",
    },
}
