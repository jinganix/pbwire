.{
    .name = .pbwire_zig,
    .version = "0.1.0",
    .fingerprint = 0x653457e32b749842,
    .minimum_zig_version = "0.14.0",
    // Baseline only (`zig build -Dbaseline=true bench-baseline`): Arwalk's
    // protobuf runtime + protoc plugin, pinned by tarball. Never resolved
