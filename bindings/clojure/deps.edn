{:paths ["runtime/src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases {;; java -cp $(clojure -Spath):../../java/out/classes ...
           ;; (the Java runtime is plain javac output, see build.sh)
           :test {:extra-paths ["tests"]}
           :examples {:extra-paths ["examples"]}
           :bench {:extra-paths ["benchmarks"]}
           :conformance {:extra-paths ["conformance"]}
           ;; Release: `clojure -T:build jar` then `clojure -X:deploy`
           ;; (CLOJARS_USERNAME + CLOJARS_PASSWORD, a deploy token).
           :build {:deps {org.clojure/tools.build {:mvn/version "0.9.2"}}
                   :ns-default build}
           :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.5"}}
                    :exec-fn deps-deploy.deps-deploy/deploy
                    :exec-args {:installer :remote
                                :artifact "target/pbwire-clojure-0.1.7.jar"}}}}
