<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PbenchGate</AssemblyName>
    <RootNamespace>Pbwire.Pbench.Gate</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Models.csproj" />
    <ProjectReference Include="../Shim.csproj" />
    <ProjectReference Include="../../Pbwire/Pbwire.csproj" />
    <ProjectReference Include="../../oracle/oracle.csproj">
      <Aliases>Oracle</Aliases>
    </ProjectReference>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
  </ItemGroup>

</Project>
