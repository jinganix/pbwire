<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Bench</AssemblyName>
    <RootNamespace>Pbwire.Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The shim model assembly keeps its own Structtest namespace; only the
         protoc baseline in gen/ may reach this project's compilation. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bench.cs" />
    <Compile Include="Pbn.cs" />
    <Compile Include="gen/*.cs" />
    <ProjectReference Include="../Pbwire/Pbwire.csproj" />
    <!-- The shim arm's model assembly keeps its own Structtest namespace; the
         protoc baseline in gen/ must stay the only one this project compiles. -->
    <ProjectReference Include="../pbench/Shim.csproj" />

    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="protobuf-net" Version="3.4.40" />
  </ItemGroup>

</Project>
