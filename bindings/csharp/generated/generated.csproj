<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GeneratedTest</AssemblyName>
    <RootNamespace>Pbwire.Generated</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Pbwire/Pbwire.csproj" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <ProjectReference Include="../oracle/oracle.csproj">
      <Aliases>Oracle</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>
