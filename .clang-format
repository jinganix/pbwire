---
# clang-format config for pbwire C sources (include/, src/, tests/).
# Apply: make format   Check: make format-check
# Requires clang-format >= 19.
Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 4
UseTab: Never
ColumnLimit: 0
AlwaysBreakAfterReturnType: AllDefinitions
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Never
  AfterEnum: false
  AfterStruct: false
  AfterUnion: false
  BeforeElse: false
AllowShortFunctionsOnASingleLine: Empty
SortIncludes: false
